{
	"name": "insertabot-cfworker",
	"main": "src/index.ts",
	"workers_dev": false,
	"preview_urls": false,
	"compatibility_date": "2026-08-02",
	"compatibility_flags": ["nodejs_compat"],
	"routes": [
		{
			"pattern": "cfworker.insertabot.io",
			"zone_name": "insertabot.io",
			"custom_domain": true,
		},
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true,
		},
		"traces": {
			"enabled": true,
			"persist": true,
			"head_sampling_rate": 1,
		},
	},
	"assets": {
		"directory": "./public",
		"not_found_handling": "single-page-application",
		"html_handling": "auto-trailing-slash",
		// `not_found_handling: single-page-application` would otherwise answer an
		// unmatched /api/* GET with index.html (200, text/html) before the Worker
		// runs, which a client parses as a corrupt JSON body.
		"run_worker_first": ["/api/*", "/agents/*", "/health"]
	},
	"ai": {
		"binding": "AI",
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["ChatAgent"],
		},
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "ChatAgent",
				"class_name": "ChatAgent",
			},
		],
	},
	// Cross-device conversation index (see src/lib/conversations.ts). Message
	// bodies stay in each ChatAgent Durable Object; this lists them.
	//
	// No database_id yet: `npm run deploy` auto-provisions a D1 database named
	// below on first deploy (or reuses it if it exists), and the Worker creates
	// its table on first use. Once it exists, pin it so every environment points
	// at the same data — copy the id from `npx wrangler d1 info
	// insertabot-conversations` into a "database_id" field here.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "insertabot-conversations",
			"migrations_dir": "migrations",
		},
	],
	"vars": {
		"SYSTEM_PROMPT": "You are InsertaBot, a helpful AI assistant with access to tools via MCP servers.",
		// Cloudflare Access verification. Neither value is a secret: TEAM_DOMAIN is
		// the public team hostname, POLICY_AUD the Access application's AUD tag.
		// Both MUST be filled in — agent routes fail closed (401) while empty.
		"TEAM_DOMAIN": "https://mistykmedia.cloudflareaccess.com",
		"POLICY_AUD": "00dab7f7e7e5ab92065f7f0fe6089bfdf1c6f6d168c2fa29719c931670aa60fe"
	}
}
