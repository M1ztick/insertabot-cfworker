{
  "name": "insertabot-cfworker",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "build": "npm run types && wrangler deploy --dry-run --outdir=dist",
    "types": "wrangler types",
    "typecheck": "npm run types && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7",
    "wrangler": "^4.130.0"
  },
  "overrides": {
    "ws": ">=8.21.0",
    "undici": ">=6.27.1",
    "sharp": ">=0.35.0",
    "fast-uri": ">=4.1.3",
    "hono": ">=4.13.5",
    "qs": ">=6.15.4",
    "@hono/node-server": ">=2.0.5"
  },
  "dependencies": {
    "@cloudflare/ai-chat": "^0.10.2",
    "agents": "^0.20.1",
    "ai": "^7.0.97",
    "jose": "^6.2.12",
    "workers-ai-provider": "^4.0.0"
  },
  "allowScripts": {
    "core-js-pure@3.49.0": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260730.1": true
  }
}
