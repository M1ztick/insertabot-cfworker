{
  "name": "insertabot-cfworker",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "build": "npm run types && wrangler deploy --dry-run --outdir=dist",
    "types": "wrangler types",
    "typecheck": "npm run types && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build",
    "db:migrate:local": "wrangler d1 migrations apply insertabot-conversations --local",
    "db:migrate:remote": "wrangler d1 migrations apply insertabot-conversations --remote"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.130.0"
  },
  "overrides": {
    "ws": ">=8.21.0",
    "undici": ">=6.27.1",
    "fast-uri": ">=4.1.3"
  },
  "dependencies": {
    "@cloudflare/ai-chat": "^0.12.2",
    "agents": "^0.32.0",
    "ai": "^7.0.97",
    "jose": "^6.2.12",
    "workers-ai-provider": "^4.0.0"
  },
  "allowScripts": {
    "core-js-pure@3.51.0": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261101.1": true
  }
}
