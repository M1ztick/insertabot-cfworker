/*
  Cache-Control: public, max-age=3600
  # Defence in depth behind the renderer's own escaping (public/markdown.js):
  # assistant output is rendered via innerHTML, so a future escaping regression
  # should not become script execution.
  #   - 'unsafe-inline' on style-src is required by the inline <style> block in
  #     index.html and the few inline style writes in index.js. Note it is NOT
  #     granted to script-src, so injected markup still cannot run.
  #   - Fonts are self-hosted under /fonts/, so no third-party font origins.
  #   - data:/blob: on img-src back the compressed image previews.
  #   - connect-src 'self' covers the same-origin WebSocket (ws: and wss:).
  #   - No analytics: Cloudflare's Web Analytics beacon (static.cloudflareinsights.com)
  #     is deliberately NOT allowed, so it cannot run even if enabled on the zone.
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self' ws: wss:; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
